     |   ^
Fix: write the package with a version, for example: w@1.2.3
=== program/kitchen-sink ===
-- source --
1 "agent Kitchen"
2 "  goal \"Do a bit of everything\""
3 "  tool file \"docs/\""
4 "  tool http allow \"api.example.com\" \"*.example.org\""
5 "  tool env \"HOME\" \"USER\""
6 "  tool state"
7 "  tool clock"
8 "  tool weather from mcp \"npx -y weather-mcp@1.2.3\" env \"HTTPS_PROXY\""
9 "  link Helper"
10 "  link Other from \"other.ag\""
11 "  remote Bob at \"https://bob.example:8080\""
12 "  accepts ask city days  # asks about a city"
13 "  accepts other"
14 "  on start"
15 "    state.set key: \"n\" value: 0"
16 "  on ask"
17 "    now = clock.now"
18 "    n = state.get key: \"n\""
19 "    data = weather.forecast city: city days: days within 30 seconds"
20 "    if data.ok is yes and n is more than 3"
21 "      reply \"{city}: {data.summary} at {now}\""
22 "    otherwise"
23 "      for c in [city, \"Lisbon\"]"
24 "        note = think \"Describe {c}\" using weather clock"
25 "        file.write path: \"out.txt\" text: note"
26 "      fail \"no data for {city}\""
27 "  on other"
28 "    reply Helper.go k: 1"
